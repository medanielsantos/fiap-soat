        <mxCell id="note3" value="Reserva e consumo são atômicos com a atualização da OS. Reserva não reduz o estoque físico; consumo reduz o físico e a quantidade reservada. Movimentações preservam o histórico do saldo." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
